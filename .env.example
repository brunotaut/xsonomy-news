# Copy to .env for local runs. NEVER commit the real keys.
# Everything here is also set as a GitHub Actions secret, so the scheduled jobs
# do not need this file — it is only for running the scripts on your own machine.

# --- Supabase ---
# The service_role key bypasses RLS; server-side scripts only, never the browser.
# Supabase dashboard -> Project Settings -> API -> service_role.
SUPABASE_URL=https://uobidcahmrmfdmfbrtkt.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# --- Claude, for the enrichment passes (enrich-companies, enrich-products) ---
ANTHROPIC_API_KEY=

# --- Resend, for the email digest ---
RESEND_API_KEY=
